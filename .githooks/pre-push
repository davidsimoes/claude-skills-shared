#!/bin/bash
# Git pre-push security scan
# Greps the to-be-pushed commit range for sensitive patterns before allowing the push.
# Enable in your local clone with: git config core.hooksPath .githooks
# Bypass once with: git push --no-verify
set -euo pipefail

# Optional blocklist file. The default location is the author's personal blocklist;
# contributors can set GIT_OS_BLOCKLIST=/path/to/their/own to override.
BLOCKLIST="${GIT_OS_BLOCKLIST:-$HOME/.claude/knowledge/opensource-security-blocklist.md}"

# Always-on regex sweep (no blocklist file required). API key shapes we never want to push.
API_KEY_REGEX='AIzaSy[A-Za-z0-9_-]{33}|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|ghs_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|xox[bps]-[0-9]+-[0-9]+-[A-Za-z0-9]+|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.|AKIA[A-Z0-9]{16}|apify_api_[A-Za-z0-9]{20,}|pat[A-Za-z0-9]{14}\.[0-9a-f]{64}|sk_live_[A-Za-z0-9]{24,}|shpat_[a-f0-9]{32}|shpca_[a-f0-9]{32}|shpss_[a-f0-9]{32}'

# Build commit ranges from git pre-push stdin
NULL_OID="0000000000000000000000000000000000000000"
RANGES=()
while read -r local_ref local_oid remote_ref remote_oid; do
    [ -z "${local_ref:-}" ] && continue
    [ "$local_oid" = "$NULL_OID" ] && continue
    if [ "$remote_oid" = "$NULL_OID" ]; then
        RANGES+=("$local_oid" "--not" "--remotes")
    else
        RANGES+=("$remote_oid..$local_oid")
    fi
done

[ ${#RANGES[@]} -eq 0 ] && exit 0

# Get added lines only from the push range.
#
# Scan the PATCH SERIES, not a two-point tree diff. Two defects fixed 2026-09-10, both
# exercised against a throwaway repo rather than reasoned about:
#
#   1. FAIL-OPEN ON A NEW BRANCH. `git diff <oid> --not --remotes` is not a valid git diff
#      invocation - diff takes two endpoints, not rev-list traversal flags. When remote_oid
#      is all-zero (a new branch, and every first push of a new public repo) it produced no
#      output at all, so a commit carrying an AKIA-prefixed AWS key passed with exit 0 and not
#      one line of output - indistinguishable from "nothing to scan". Measured: existing
#      branch exit=1, new branch exit=0, same planted key.
#   2. ADD-THEN-REMOVE NETS TO ZERO. Even on an existing branch a tree diff cancels a secret
#      added in one commit and deleted in the next, while both commits and the blob still
#      reach the remote forever. A push publishes patches, not tree state.
#
# The Claude-side scanner had the identical bug and was
# fixed the same way on 2026-09-09; this is the same class, swept.
#
# And the enumeration now FAILS CLOSED: a range git cannot walk refuses the push instead of
# passing on evidence it never gathered.
if ! RAW_LOG=$(git log -p --no-color --format= "${RANGES[@]}" -- ':!*.lock' ':!package-lock.json' 2>&1); then
    {
        echo ""
        echo "[X] pre-push security scan could not enumerate the commits this push would publish."
        echo ""
        echo "    git said: $RAW_LOG"
        echo ""
        echo "    Refusing the push rather than reporting an all-clear it never earned."
        echo "    Fetch first so remote-tracking refs exist, then retry."
        echo ""
    } >&2
    exit 1
fi

DIFF_CONTENT=$(printf '%s\n' "$RAW_LOG" | grep '^+' | grep -v '^+++' || true)
[ -z "$DIFF_CONTENT" ] && exit 0

VIOLATIONS=""

# Literal-string scan from blocklist file (if available)
if [ -f "$BLOCKLIST" ]; then
    LITERAL_PATTERNS=$(awk '
        /^## §1/ { skip = 1; next }
        /^## §[2-9]/ { skip = 0 }
        !skip && /^- `[^`]+`/ {
            match($0, /`[^`]+`/)
            s = substr($0, RSTART + 1, RLENGTH - 2)
            sub(/^\*@/, "@", s)
            if (s != "") print s
        }
    ' "$BLOCKLIST" | sort -u)

    if [ -n "$LITERAL_PATTERNS" ]; then
        while IFS= read -r pat; do
            [ -z "$pat" ] && continue
            if echo "$DIFF_CONTENT" | grep -F -- "$pat" >/dev/null 2>&1; then
                VIOLATIONS+="literal: $pat"$'\n'
            fi
        done <<< "$LITERAL_PATTERNS"
    fi
fi

# Regex API-key sweep (always runs)
if echo "$DIFF_CONTENT" | grep -E "$API_KEY_REGEX" >/dev/null 2>&1; then
    matches=$(echo "$DIFF_CONTENT" | grep -oE "$API_KEY_REGEX" | sort -u | head -5)
    VIOLATIONS+="API key pattern matches: $matches"$'\n'
fi

if [ -n "$VIOLATIONS" ]; then
    {
        echo ""
        echo "[X] pre-push security scan BLOCKED the push"
        echo ""
        echo "The following sensitive patterns were detected in the commits being pushed:"
        echo ""
        echo "$VIOLATIONS" | sed 's/^/  /'
        echo ""
        echo "Fix the offending content (amend or new commit) and try again."
        echo "To override (NOT recommended), use: git push --no-verify"
        echo ""
    } >&2
    exit 1
fi

echo "[OK] pre-push security scan PASSED" >&2
exit 0
